# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Environmental variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Debug and system files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.AppleDouble
.LSOverride

# Jest coverage
coverage/
.nyc_output

# Temporary files
tmp/
temp/

# Generated asset files (images, uploads) - not source, shouldn't be committed
uploads/*
!uploads/.gitkeep

# Claude Code local/machine-specific state - permissions and session locks
# are per-developer, not project config. launch.json (dev-server preview
# config) is the one file in here worth sharing - stays tracked.
.claude/settings.local.json
.claude/scheduled_tasks.lock
