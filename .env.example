PORT=3000
NODE_ENV=development

# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brandcore_auth
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/brandcore_auth_test

# JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# JWT Expiration times
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Argon2 configuration parameters (calibrate to get 50-250ms hashing time)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# AI providers (see HANDOFF.md §21/§22 for why there are two of these).
#
# Groq - free, and the primary text LLM for this app: campaign copy,
# campaign ideas, Brand DNA synthesis, text-based Brand QA, and chat
# answers all go through this (src/services/groq.service.ts). Sign up at
# https://console.groq.com and create an API key (no credit card required
# for the free tier). Every feature that uses this degrades to a local
# heuristic/no-op fallback when unset, so the app is fully usable without
# it, just less capable/accurate.
GROQ_API_KEY=

# Gemini - used for (1) website-knowledge embeddings feeding the Qdrant
# Knowledge Base / chat Q&A feature (src/services/embedding.service.ts),
# and (2) image Brand QA / vision (creative.service.ts's
# runImageBrandQaNode) - Groq has neither an embeddings endpoint nor (as of
# this session) any vision-capable model in its live catalog, so both of
# these stay on Gemini even though text generation itself moved to Groq.
# Removing this key doesn't break chat *answers* (those are Groq) or text
# QA, but it does silently downgrade website knowledge *search* to a plain
# in-memory substring match, and skips image Brand QA entirely (generated
# images ship unreviewed). Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# "Sign in with Google" - free (Google OAuth has no cost/quota for this use).
# Create one at https://console.cloud.google.com/apis/credentials:
#   1. "Create Credentials" -> "OAuth client ID" -> Application type "Web application"
#   2. Authorized JavaScript origins: http://localhost:5173 (dev) and your
#      production origin (e.g. https://app.yourdomain.com) - no path, no trailing slash
#   3. Copy the Client ID into BOTH of these (same value, two names because
#      one is read server-side and the other is inlined into the frontend
#      build by Vite - see src/frontend/src/components/auth/GoogleAuthButton.tsx)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Real BullMQ job queue (src/services/queue.service.ts) - free, self-hosted.
# docker run -d --name brandcore-redis -p 6379:6379 redis:7-alpine
# Every feature that uses this (background Knowledge Base embedding after a
# scan) falls back to running synchronously in-process when unset, so the
# app is fully usable without Redis, just without real background job
# durability/concurrency control.
REDIS_URL=redis://localhost:6379

# Optional overrides for the generation cache's bounded eviction policy
# (src/services/cache.service.ts) - per-namespace (userId+brandDnaId) LRU
# cap and TTL. Sensible defaults apply if unset (200 entries / 6 hours).
# CACHE_MAX_ENTRIES_PER_NAMESPACE=200
# CACHE_TTL_MS=21600000

# Real Qdrant vector DB (src/services/qdrant.service.ts) - free, self-hosted.
# docker run -d --name brandcore-qdrant -p 6333:6333 -p 6334:6334 qdrant/qdrant:latest
# The Knowledge Base / website Q&A chatbot features need this - without it,
# the crawled site is never indexed and chat falls back to "no knowledge
# base available for this brand yet" rather than erroring.
QDRANT_URL=http://localhost:6333

# Transactional email (verification + password reset) - free at this volume.
# Sign up at https://resend.com, verify a sending domain (or use their
# sandbox `onboarding@resend.dev` sender for testing with no domain setup),
# and create an API key. With RESEND_API_KEY unset, emails are logged to the
# console instead of sent - fully functional for local dev/testing, just not
# delivered anywhere real. See src/services/email.service.ts.
RESEND_API_KEY=
EMAIL_FROM=BrandCore <onboarding@resend.dev>

# Base URL used to build verification/reset links inside emails. Must match
# wherever the frontend is actually served.
FRONTEND_URL=http://localhost:5173
